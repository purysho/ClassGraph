{
  "name": "classgraph",
  "version": "0.6.0",
  "private": true,
  "description": "Local-first classroom analysis, visualisation, seating and grouping planner.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node dist/server-main.js",
    "start": "node dist/server-main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "docx": "9.7.1",
    "pdf-lib": "1.17.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "jszip": "3.10.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^5.0.2"
  }
}
